# RPC endpoints for the on-chain tests (marker "onchain") and for v4quote.chain.rpc.get_web3(<chain>).
# Copy to .env and fill in what you need; tests for a chain are skipped while its variable is empty.
# Some tests need archive state at older blocks. Never commit a filled .env.
AVALANCHE_RPC_URL=
MONAD_RPC_URL=
GNOSIS_RPC_URL=
PULSECHAIN_RPC_URL=
# optional: dedicated / second endpoints for eth_getLogs scanning (v4quote.chain.logs)
AVALANCHE_LOGS_RPC_URL=
AVALANCHE_LOGS_CROSSCHECK_RPC_URL=
MONAD_LOGS_RPC_URL=
MONAD_LOGS_CROSSCHECK_RPC_URL=
# set to 0 to force the pure-Python backend even when v4quote_native is installed
V4QUOTE_NATIVE=
